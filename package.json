{
  "name": "arc-pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "USDC wallet dashboard, payments/invoicing, and an autonomous agent-pays demo on Arc (Circle's EVM L1).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsx src/cli/check.ts",
    "build:client": "vite build",
    "dev": "pnpm build:client && tsx src/cli/serve.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "build": "pnpm build:client && tsc -p tsconfig.build.json",
    "start": "node dist/src/cli/serve.js"
  },
  "dependencies": {
    "@circle-fin/adapter-circle-wallets": "^1.6.0",
    "@circle-fin/adapter-viem-v2": "^1.15.0",
    "@circle-fin/app-kit": "^1.12.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@types/node": "^22.10.0",
    "solc": "^0.8.36",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
