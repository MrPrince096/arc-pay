# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in. NEVER commit `.env` (it's gitignored).
# ---------------------------------------------------------------------------

# --- Arc testnet (public, no key needed) ------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_WS_URL=wss://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app
PORT=8787

# --- Agent-pays demo (only needed for that feature — leave blank otherwise) -
# Free Circle Developer account -> API key + entity secret.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# The agent's own wallet address (fund it via https://faucet.circle.com).
AGENT_WALLET_ADDRESS=
AGENT_MAX_SPEND_PER_ACTION_USDC=0.01
AGENT_DAILY_SPEND_CAP_USDC=1.00
# Live agent sends stay OFF until set to this EXACT value (a deliberate gate).
AGENT_LIVE_CONFIRM=
